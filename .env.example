# Copy to .env and adjust. docker-compose reads this file automatically.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
DJANGO_TIME_ZONE=Asia/Kolkata
ENVIRONMENT=local

# --- Database ---
# Inside docker-compose the host is the service name, "db".
DATABASE_URL=postgresql://eve:eve@db:5432/eve_diagnostics
POSTGRES_DB=eve_diagnostics
POSTGRES_USER=eve
POSTGRES_PASSWORD=eve

# --- Redis (cache + Celery broker). Leave blank to run without Redis. ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
# Set true to process webhooks inline instead of on a worker.
CELERY_TASK_ALWAYS_EAGER=false

# --- JWT ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- Simulated payment provider ---
PAYMENT_CURRENCY=INR
# success | failure | random
PAYMENT_DEFAULT_OUTCOME=random
PAYMENT_SUCCESS_RATE=0.8
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
PAYMENT_WEBHOOK_REQUIRE_SIGNATURE=true
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
PAYMENT_WEBHOOK_MAX_RETRIES=5

# --- Booking rules ---
BOOKING_MIN_LEAD_TIME_MINUTES=30
BOOKING_MAX_ADVANCE_DAYS=90
BOOKING_CANCELLATION_CUTOFF_HOURS=2

# --- Throttling ---
THROTTLE_ANON=60/min
THROTTLE_USER=240/min
THROTTLE_AUTH=10/min
THROTTLE_PAYMENTS=20/min
THROTTLE_WEBHOOK=600/min

# --- Logging ---
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=console
